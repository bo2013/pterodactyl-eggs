{
    "$schema": "../schema.json",
    "_comment": "Do not send emails to this address. I do not receive them.",
    "name": "github-actions-runner",
    "meta": {
        "version": "PTDL_v2",
        "update_url": "https://raw.githubusercontent.com/bo2013/pterodactyl-eggs/main/github-actions-runner/egg.json"
    },
    "author": "liuphuc06@gmail.com",
    "description": "GitHub Actions self-hosted runner.",
    "features": null,
    "docker_images": {
        "gar-2.336.0-ubuntu": "ghcr.io/bo2013/pterodactyl-eggs:gar-2.336.0-ubuntu"
    },
    "startup": "if [ ! -f .runner ]; then ./config.sh --url \"$GAR_URL\" --token \"$GAR_TOKEN\" --unattended; fi; ./run.sh",
    "config": {
        "files": "{}",
        "startup": "{}",
        "logs": "{}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "",
            "container": "docker.io/ubuntu:24.04",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "Github actions runner URL",
            "description": "Take from Your Repo > Settings > Actions > Runners > New self-hosted runner",
            "env_variable": "GAR_URL",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string",
            "field_type": "text"
        },
        {
            "name": "Github actions runner Token",
            "description": "Take from Your Repo > Settings > Actions > Runners > New self-hosted runner",
            "env_variable": "GAR_TOKEN",
            "default_value": "",
            "user_viewable": true,
            "user_editable": true,
            "rules": "required|string",
            "field_type": "text"
        }
    ]
}